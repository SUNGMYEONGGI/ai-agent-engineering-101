)\\n  if not skus or u['sku'] in skus: groups[(u['sku'],u['grade'])].append({k:u.get(k) for k in ('unit','cost','supplied_at','expires_at')})\\n allowed=set(list(dict.fromkeys(k[0] for k in", "ts": 1795644880}
