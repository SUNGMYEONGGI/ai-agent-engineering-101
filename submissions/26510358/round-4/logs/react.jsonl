ck/catalog.json','prices':[{'sku':'s','grade':'B','price':2000,'warranty_hours':3}]},kit)\\n a=x['items'][0]; assert all(k in a for k in ['sku','name','grade','price','stock','units','warran", "ts": 1795602612}
