'/api/forum?role=shop&limit=100',timeout=10);r.raise_for_status();forum=r.json()\\n  if isinstance(ledger,dict):ledger=ledger.get('entries',ledger.get('ledger',[]))\\n  if not isinstance(items,list)", "ts": 1795819764}
