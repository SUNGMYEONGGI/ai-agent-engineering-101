'url')\\n        if not safe_endpoint(endpoint): return {'ok':False,'error':'카드에 안전한 상점 A2A 주소 없음','stage':stage}\\n        stage='a2a'\\n        rid=str(uuid.uuid4())\\n        payload={'jsonrpc':'2.0','id':rid,'method':'message", "ts": 1795663845}
