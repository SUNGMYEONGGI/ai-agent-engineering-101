ckout_jwt':jwt,'unit':u['unit'],'price':price,'sku':x['sku'],'name':x['name'],'grade':grade,'expires_at':u.get('expires_at'),'warranty_hours':x.get('warranty_hours',0),'hold_until':int(t+180)})\\\\\\\\n    f.seek(0);f.truncate();json.dump(holds,f,ensure_ascii=False);f.flush();fcntl.flock(f,fcntl.LOCK_UN)\\\\\\\\n   if unavai", "ts": 1795765828}
