les[(sku,g)].append(p);names[sku]=d.get('name','') or names.get(sku,'')\\n  if stamp(r):times.append(stamp(r))\\n top=[{'sku':s,'grade':g,'name':names.get(s,''),'count':len(ps),'median':stat", "ts": 1795734876}
