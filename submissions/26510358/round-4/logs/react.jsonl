turn {'ok':True,'files':{r:[str(p) for p in Path(r).glob('**/*') if p.is_file() and ('a2a' in str(p).lower() or r=='ops')][:120] for r in ['tools','ops','logs']}}\\n  ", "ts": 1795752227}
