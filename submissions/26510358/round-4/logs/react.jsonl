t('settled') is True or x.get('status')=='settled' or x.get('state')=='settled' or settled(x.get('result')) or settled(x.get('data')))\\ndef requests(text):\\n hits=[]\\n for n,words in ALIASES.items():\\n  for w in words:", "ts": 1795774587}
