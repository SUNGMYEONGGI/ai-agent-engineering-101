rue,exist_ok=True)\\n   with wp.open('a',encoding='utf8') as f:\\n    for item in missing:f.write(json.dumps({'ts':int(time.time()),'item':item,'buyer':a.get('claimed_from')},ensure_as", "ts": 1795705430}
