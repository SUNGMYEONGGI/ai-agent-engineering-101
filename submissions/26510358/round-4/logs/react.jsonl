ours']))\\n   if unavailable:msg.append('와 '.join(unavailable)+'은(는) 없습니다.')\\n   msg+=errors\\n   data={'checkouts':results}\\n   if len(results)==1:data.update(results[0])\\n   return say", "ts": 1795756569}
