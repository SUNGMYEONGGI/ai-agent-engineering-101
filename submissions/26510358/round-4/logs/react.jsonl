() and type(x.get('price')) is int and x['price']>0 and x.get('name'):available.append((x,u));break\\n    available.sort(key=lambda z:(stamp(z[1].get('expires_at')) or float('inf'),stamp(z[1].get('supplied_at'))));selec", "ts": 1795806640}
