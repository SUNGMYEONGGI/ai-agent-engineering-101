hours':x.get('warranty_hours',0),'hold_until':int(now+180)});line+=' 결제서 180초 보류.'\\n     lines.append(line)\\n    f.seek(0);f.truncate();json.dump(holds,f,ensure_ascii=False);f.flush();fcntl.flock(f,fcntl.LOCK_UN", "ts": 1795819178}
