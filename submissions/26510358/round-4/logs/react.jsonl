;r.raise_for_status();units=r.json()['units']\\n   r=httpx.get(kit.market.rstrip('/')+'/api/ledger?after=-500',timeout=12);r.raise_for_status();ledger=r.json();now=time.time()\\n  if isinstance", "ts": 1795804084}
