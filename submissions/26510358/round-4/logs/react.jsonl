eout=10);ir.raise_for_status();inv=ir.json()\\n   fr=httpx.get(kit.market.rstrip('/')+'/api/forum?role=shop&limit=100',timeout=10);fr.raise_for_status();forum=fr.json()\\n  if isinstance(l", "ts": 1795773905}
