median_price\": 39000, \"shelf_hours\": 720}, {\"category\": \"건강용품/식품>다이어트/건강기능>전통건강식품\", \"item\": \"전통건강식품\", \"kind\": \"food\", \"skus\": 8, \"median_price\": 31900, \"shelf_hours\": 720}, {\"category\": \"건강용품/식품>다이어트/건강기능>헬스보조식품\", \"item\": \"헬스보조식품\", \"kind\": \"food\", \"skus\": 1, \"median_price\": 21900, \"shelf_hours\": 720}, {\"category\": \"공구>수동공구>나이프\", \"item\": \"나이프\", \"kind\": \"goods\", \"skus\": 1, \"median_price\": 1580, \"shelf_hours\": null}, {", "ts": 1795553149}
