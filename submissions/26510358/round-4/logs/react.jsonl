et('at',0)))\\n except (TypeError,ValueError):return 0\\ndef norm(x):return str(x or '').rstrip('/').lower()\\ndef run(a,k):\\n try:\\n  mode=a.get('mode')\\n  if mode=='a2a':\\n   u=a.get('card_url')\\n   ", "ts": 1795789620}
