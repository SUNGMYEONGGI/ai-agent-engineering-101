et('data') if isinstance(a.get('data'),dict) else {}\\n match=re.search(r'(?<![0-9A-Za-z])G[0-9a-fA-F]{8}(?![0-9A-Za-z])',text)\\n sku=str(data.get('sku') or (match.group() if match else ''))\\n if sku and re.search(r'SKU\\\\s+'+re.escape(sku)+r'.{0,30}없습니다',reply,re.I):missing.append('", "ts": 1795757974}
