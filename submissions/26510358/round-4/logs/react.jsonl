out_jwt') or ((cm or {}).get('mandate') or {}).get('checkout_jwt')\\n  if not all([pm,cm,order,jwt]):return answer('정산에 주문, checkout_jwt와 두 mandate가 모두 필요합니다.')\\n  body={'order':order,'checkout_jwt':jwt,'checkout_mandat", "ts": 1795600131}
