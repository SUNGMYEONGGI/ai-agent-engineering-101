sonl')):\\n    t=x.get('text','');at=stamp(x);d=x.get('data');r=x.get('reply','')\\n    if not since<=at<=now+10 or not isinstance(t,str) or not t.strip() or '연결점검' in t or isins", "ts": 1795810365}
