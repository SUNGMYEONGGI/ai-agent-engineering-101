it.token('shop')},json=body,timeout=8)\\ndef say(s,data=None,state='input_required'):\\n r={'reply':s,'state':state}\\n if data is not None:r['data']=data\\n return r\\ndef settled(x):\\n if not isinstance(x,dict):ret", "ts": 1795698879}
