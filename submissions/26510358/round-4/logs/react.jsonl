':[{'choice':'none','probability':1}]}};r=run(a,kit);out=r['data']['checkouts'];assert set(x['sku'] for x in out)==set(expected),(text,r)\\n  for c in out:\\n   assert c['name'] in r['reply'] ", "ts": 1795809950}
