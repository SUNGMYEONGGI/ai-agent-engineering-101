!='none':\\n     picks=[z for z in available if str(z[0]['sku'])+':'+str(z[0]['grade'])==choice]\\n     if picks and (not req or any(matches(n,picks[0][0]) and (not g or g==picks[0][1]['grade']) for n,g in req)):selecte", "ts": 1795818563}
