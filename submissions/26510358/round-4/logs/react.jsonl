{k:x[k] for k in ('sku','name','grade','price','stock','warranty_hours','expires_at') if k in x} for x in items if type(x.get('stock')) is int and x['stock']>0 and all(x.get(k) for k in ('sku','name','grade','price'))]\\n        keywords=('계란','김치','채소','콩나물','취나물',", "ts": 1795614201}
