on=body,timeout=8)\\n\\ndef requests(text):\\n found=[]; occupied=[]\\n for noun,words in sorted(NOUNS.items(),key=lambda v:-max(map(len,v[1]))):\\n  for w in words:\\n   for m in re.finditer(re.esca", "ts": 1795760508}
