요',['egg']),('둥굴레차 B등급 3051원 결제서 주세요',['tea'])]\\n def call(text,inv=units):\\n  suffix=uuid.uuid4().hex\\n  return run({'text':text,'catalog_path':str(cp),'holds_path':str(root/(tag+'h'+suffix)),'customers_path':str(root", "ts": 1795759689}
