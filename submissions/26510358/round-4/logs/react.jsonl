th(a['source']);dst=Path(a['dest']);assert str(dst) in ('ops/a2a_v16.py','ops/a2a_v16_test.py') or kit.testing and str(dst).startswith('tmp/test/');assert str(src).startswith(('tools/',", "ts": 1795732083}
