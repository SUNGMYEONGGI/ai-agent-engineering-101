settle' or r.get('round',4)!=4:continue\\n  d=r.get('data') or {};u=norm(d.get('shop_url') or d.get('shop'));counts[byurl.get(u) or d.get('shop') or '?']+=1\\n  sku=d.get('sku') or (d.get('i", "ts": 1795738036}
