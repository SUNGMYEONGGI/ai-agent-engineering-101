-F]{8}\\\\b',text)\\n sku=str(data.get('sku') or (match.group() if match else ''))\\n if sku and re.search(r'SKU\\\\s+'+re.escape(sku)+r'.{0,30}없습니다',reply,re.I):missing.append('SKU '+sku)\\n if missin", "ts": 1795733205}
